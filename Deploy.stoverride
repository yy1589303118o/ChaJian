rules:
  # 广告
  - RULE-SET,Advertising,🚫 广告拦截
  - RULE-SET,Hijacking,🚫 广告拦截
  - RULE-SET,Privacy,🚫 广告拦截

  # AI
  - RULE-SET,OpenAI,🤖 AI节点
  - RULE-SET,Claude,🤖 AI节点
  - RULE-SET,Anthropic,🤖 AI节点
  - RULE-SET,Gemini,🤖 AI节点
  - RULE-SET,Copilot,🤖 AI节点

  # Apple
  - RULE-SET,Apple,🍎 苹果服务
  - RULE-SET,AppStore,🍎 苹果服务
  - RULE-SET,TestFlight,🍎 苹果服务
  - RULE-SET,iCloud,🍎 苹果服务

  # 国内
  - RULE-SET,自用分流,☁️ 国内直连
  - RULE-SET,China,☁️ 国内直连
  - RULE-SET,ChinaIPs,☁️ 国内直连,no-resolve
  - RULE-SET,LAN,☁️ 国内直连
  - RULE-SET,WeChat,☁️ 国内直连
