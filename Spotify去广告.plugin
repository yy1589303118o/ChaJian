[Plugin]
name = Spotify去广告
desc = Spotify 精准去广告 + 首页净化 + iPad ArtistView 修复｜优先保证播放稳定
author = Spotify

[Rule]
DOMAIN-SUFFIX,ads.spotify.com,REJECT
DOMAIN-SUFFIX,adstudio.spotify.com,REJECT
DOMAIN-SUFFIX,gads.spotify.com,REJECT

[URL Rewrite]
^https?:\/\/(?:ads|adclick|gads)\.spotify\.com(?:\/.*)?$ - reject
^https?:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/artistview\/v1\/artist\/(.*)&platform=iphone https://spclient.wg.spotify.com/artistview/v1/artist/$1&platform=ipad header

[Map Local]
^https?:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:ads|ad-logic|pendragon)(?:\/.*)?$ data="{}" status=200

[Script]
http-response ^https?:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service|home-feed-view|user-attribute)(?:[\/?].*)?$ script-path=https://raw.githubusercontent.com/yy1589303118o/ChaJian/refs/heads/main/Spotify_remove_ads_local.js, requires-body=true, timeout=10, tag=Spotify去广告

[Mitm]
hostname = *.spclient.spotify.com, spclient.wg.spotify.com, ads.spotify.com, gads.spotify.com
