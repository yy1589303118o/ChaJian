{
  "id": "fanqie.reader",
  "name": "番茄小说去广告",
  "author": "Fanqie",
  "apps": [
    {
      "id": "Fanqie",
      "name": "🍅 番茄小说去广告",
      "keys": [
        "Fanqie_Enable",
        "Fanqie_RemoveAdFields",
        "Fanqie_RemoveAdFlags",
        "Fanqie_CleanCellList",
        "Fanqie_CleanData",
        "Fanqie_CleanFeed",
        "Fanqie_CleanReader",
        "Fanqie_CleanLive",
        "Fanqie_StrictMode",
        "Fanqie_Debug",
        "Fanqie_CustomKeys"
      ],
      "settings": [
        {
          "id": "Fanqie_Enable",
          "name": "总开关",
          "val": true,
          "type": "boolean",
          "desc": "关闭后 fanqie.js 不修改番茄小说响应"
        },
        {
          "id": "Fanqie_RemoveAdFields",
          "name": "广告字段清理",
          "val": true,
          "type": "boolean",
          "desc": "删除常见广告字段，例如 ad_info、banner_ad、feed_ad 等"
        },
        {
          "id": "Fanqie_RemoveAdFlags",
          "name": "广告标记清理",
          "val": true,
          "type": "boolean",
          "desc": "清理 ad_exist、show_ad、is_ad 等广告状态标记"
        },
        {
          "id": "Fanqie_CleanCellList",
          "name": "清理 cell_list",
          "val": true,
          "type": "boolean",
          "desc": "过滤阅读页、推荐页中的广告 cell"
        },
        {
          "id": "Fanqie_CleanData",
          "name": "清理 data",
          "val": true,
          "type": "boolean",
          "desc": "过滤 data 数组中的明确广告对象"
        },
        {
          "id": "Fanqie_CleanFeed",
          "name": "清理推荐广告",
          "val": true,
          "type": "boolean",
          "desc": "清理 feed、recommend 等推荐数据中的广告对象"
        },
        {
          "id": "Fanqie_CleanReader",
          "name": "清理阅读页广告",
          "val": true,
          "type": "boolean",
          "desc": "处理阅读、章节相关数据中的广告对象"
        },
        {
          "id": "Fanqie_CleanLive",
          "name": "清理直播/视频广告",
          "val": true,
          "type": "boolean",
          "desc": "删除直播、视频广告相关字段"
        },
        {
          "id": "Fanqie_StrictMode",
          "name": "严格模式",
          "val": false,
          "type": "boolean",
          "desc": "进一步删除明确识别为广告的嵌套对象。正常使用建议关闭"
        },
        {
          "id": "Fanqie_Debug",
          "name": "调试模式",
          "val": false,
          "type": "boolean",
          "desc": "用于排查脚本是否执行，正常使用建议关闭"
        },
        {
          "id": "Fanqie_CustomKeys",
          "name": "自定义广告字段",
          "val": "",
          "type": "text",
          "desc": "多个字段使用英文逗号分隔，例如：xxx_ad,another_ad"
        }
      ]
    }
  ]
}
