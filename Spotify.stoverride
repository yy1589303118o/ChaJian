name: Spotify去广告
desc: 移除 Spotify 首页与列表广告

http:
  mitm:
    - "spclient.wg.spotify.com"
    - "api-partner.spotify.com"

  url-rewrite:
    - ^https?:\/\/spclient\.wg\.spotify\.com\/ads\/ - reject
    - ^https?:\/\/spclient\.wg\.spotify\.com\/ad-logic\/ - reject

  script:
    - match: ^https?:\/\/spclient\.wg\.spotify\.com\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize|customize-v2\/v1\/customize)
      name: Spotify去广告
      type: response
      require-body: true
      timeout: 10

script-providers:
  Spotify去广告:
    url: https://raw.githubusercontent.com/yy1589303118o/ChaJian/refs/heads/main/Spotify_remove_ads_local.js
    interval: 86400

rules:
  - DOMAIN-KEYWORD,spotify-com-ad,REJECT
  - DOMAIN-SUFFIX,ads.spotify.com,REJECT
  - DOMAIN,adeventtracker.spotify.com,REJECT
  - DOMAIN,ads-fa.spotify.com,REJECT
  - DOMAIN,analytics.spotify.com,REJECT
  - DOMAIN,crashdump.spotify.com,REJECT
  - DOMAIN,log.spotify.com,REJECT
