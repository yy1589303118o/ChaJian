name: 番茄小说去广告
desc: 番茄小说 iOS 去广告：广告域名 + 广告资源 + 响应清理

# 域名与规则匹配
rules:
  # 放行听书音频流（TTS）
  - DOMAIN-KEYWORD,-tts.fqnovelvod.com,DIRECT

  # 1. 番茄 / 字节广告核心域名
  - DOMAIN,p6-ad-sign.byteimg.com,REJECT
  - DOMAIN,p9-ad-sign.byteimg.com,REJECT
  - DOMAIN,i.snssdk.com,REJECT
  - DOMAIN,i-lq.snssdk.com,REJECT
  - DOMAIN,is.snssdk.com,REJECT
  - DOMAIN,mcs.snssdk.com,REJECT
  - DOMAIN,dig.bdurl.net,REJECT
  - DOMAIN-KEYWORD,zijieapi,REJECT
  - DOMAIN-KEYWORD,applog,REJECT
  - DOMAIN,activity-ag.awemeughun.com,REJECT
  - DOMAIN,tnc3-alisc1.snssdk.com,REJECT
  - DOMAIN,tnc3-aliec2.snssdk.com,REJECT
  - DOMAIN,security-lq.snssdk.com,REJECT

  # 2. 字节广告资源
  - DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
  - DOMAIN-SUFFIX,byteorge.com,REJECT
  - DOMAIN-SUFFIX,bytegoofy.com,REJECT
  - DOMAIN,sf3-ttcdn-tos.pstatp.com,REJECT

  # 3. 番茄广告视频
  - DOMAIN-SUFFIX,fqnovelvod.com,REJECT

  # 4. Pangolin 广告 SDK
  - DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT

  # 5. 番茄相关广告接口
  - DOMAIN-KEYWORD,ad-sign,REJECT
  - DOMAIN-KEYWORD,ad-app,REJECT

  # 6. 拦截 QUIC（UDP 443）
  - AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT

# HTTP 重写、脚本与 MITM 必须全部收纳在 http 节点下
http:
  mitm:
    - "*.fqnovel.com"
    - "*.dragonread.com"
    - "*.pangolin-sdk-toutiao.com"
    - "*.pstatp.com"
    - "*.pglstatp-toutiao.com"
    - "*.snssdk.com"
    - "*.byteimg.com"

  # URL 重写拦截（对应原 url-rewrite，采用 url-regex 格式）
  url-rewrite:
    - match: ^https?:\/\/.+\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/(get_ads|stats|settings)\/
      reject: true
    - match: ^https?:\/\/.+\.pglstatp-toutiao\.com\/.+\/toutiao\.mp4
      reject: true
    - match: ^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/(obj|img)\/(ad-app-package|ad)\/.+
      reject: true
    - match: ^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/(obj|img)\/web\.business\.image\/.+
      reject: true
    - match: ^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/obj\/ad-pattern\/renderer
      reject: true
    - match: ^https?:\/\/gurd\.snssdk\.com\/src\/server\/v3\/package
      reject: true
    - match: ^https?:\/\/.+\.byteimg\.com\/tos-cn-i-1yzifmftcy\/(.+)-jpeg\.jpeg
      reject: true
    - match: ^https?:\/\/.+\.pstatp\.com\/obj\/mosaic-legacy\/.+\?from\=ad
      reject: true
    - match: ^https?:\/\/.+\.pstatp\.com\/bytecom\/resource\/track_log\/src\/.+
      reject: true
    - match: ^https?:\/\/.+\.snssdk\.com\/video\/play\/1\/toutiao\/.+\/mp4
      reject: true
    - match: ^https?:\/\/.+\.snssdk\.com\/api\/ad\/.+
      reject: true
    - match: ^http:\/\/.+\.byteimg\.com\/ad-app-package
      reject: true
    - match: ^http:\/\/.+\.byteimg\.com\/web\.business\.image
      reject: true
    - match: ^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/(ad-app-package|ad)\/.+
      reject: true
    - match: ^https?:\/\/adim\.pinduoduo\.com\/.+\/toutiao\?.+
      reject: true
    - match: ^https?:\/\/.+novelapp\.fqnovelvod\.com\/.+\/video\/.+
      reject: true

  # 脚本配置
  script:
    - match: ^https?:\/\/.+\.(fqnovel|dragonread)\.com\/(?:novel|reading|api|v\d+|ad|service)(?:[\/?].*)?$
      name: fanqie_no_ad
      type: response
      require-body: true
      timeout: 15

# Stash 需要单独的 script-providers 声明远程 JS 文件地址
script-providers:
  fanqie_no_ad:
    url: https://raw.githubusercontent.com/yy1589303118o/ChaJian/refs/heads/main/fanqie.js
    interval: 86400
