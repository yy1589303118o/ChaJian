rules:
  # 0. 当前 BiuBiu / AdGuard 本地服务
  - DOMAIN,eue-l8br0hnh515w.api-biubiu.sbs,DIRECT
  - DOMAIN,injections.adguard.org,DIRECT
  - DOMAIN,local.adguard.org,DIRECT
  - DOMAIN-SUFFIX,local,DIRECT

  # 1. AI → BiuBiu
  - RULE-SET,OpenAI,BiuBiu
  - RULE-SET,Claude,BiuBiu
  - RULE-SET,Gemini,BiuBiu
  - RULE-SET,Copilot,BiuBiu

  # 2. Apple
  # 不新增宽泛 Apple 规则，保留你现有 85 条中的 Apple 分流：
  # developer.apple.com / TestFlight / iTunes / apps.apple.com 等 → BiuBiu
  # mzstatic.com / icloud.com / apple.com / apple-cloudkit.com → DIRECT

  # 3. 游戏
  - RULE-SET,SteamCN,DIRECT
  - RULE-SET,Steam,BiuBiu
  - RULE-SET,Nintendo,BiuBiu
  - RULE-SET,PlayStation,BiuBiu
  - RULE-SET,Epic,BiuBiu
  - RULE-SET,Game,BiuBiu

  # 4. 国际
  - RULE-SET,YouTube,BiuBiu
  - RULE-SET,Spotify,BiuBiu
  - RULE-SET,Telegram,BiuBiu
  - RULE-SET,Instagram,BiuBiu
  - RULE-SET,Twitter,BiuBiu
  - RULE-SET,GitHub,BiuBiu
  - RULE-SET,Google,BiuBiu
  - RULE-SET,Reddit,BiuBiu
  - RULE-SET,Netflix,BiuBiu
  - RULE-SET,Disney,BiuBiu

  # 5. LAN → DIRECT
  - RULE-SET,LAN,DIRECT

  # 6. 原配置中的广告、Apple、国内、GEOIP、MATCH 继续保留
