[Plugin]
name = 番茄小说去广告
desc = 番茄小说 iOS 广告拦截 + 响应清理
author = Fanqie

[Rule]

# ==============================
# 番茄广告投放
# ==============================

DOMAIN,p6-ad-sign.byteimg.com,REJECT
DOMAIN,p9-ad-sign.byteimg.com,REJECT

DOMAIN-KEYWORD,ad-sign,REJECT

# ==============================
# 字节广告 / SDK
# ==============================

DOMAIN,i.snssdk.com,REJECT
DOMAIN,i-lq.snssdk.com,REJECT
DOMAIN,is.snssdk.com,REJECT

DOMAIN,mcs.snssdk.com,REJECT
DOMAIN,security-lq.snssdk.com,REJECT

DOMAIN,tnc3-alisc1.snssdk.com,REJECT
DOMAIN,tnc3-aliec2.snssdk.com,REJECT

DOMAIN-KEYWORD,snssdk,REJECT
DOMAIN-KEYWORD,zijieapi,REJECT
DOMAIN-KEYWORD,pstatp,REJECT

# ==============================
# 广告点击 / 追踪
# ==============================

DOMAIN,dig.bdurl.net,REJECT
DOMAIN-KEYWORD,applog,REJECT

DOMAIN,activity-ag.awemeughun.com,REJECT

# ==============================
# HTTPDNS
# ==============================

DOMAIN-KEYWORD,tnc,REJECT

# ==============================
# 番茄统计
# ==============================

DOMAIN,mon.toutiaocloud.com,REJECT
DOMAIN,mon.toutiaocloud.net,REJECT

# ==============================
# 图片 CDN
# 不要拦 byteimg
# ==============================

DOMAIN-SUFFIX,byteimg.com,DIRECT
[Script]

# 番茄小说 API 响应清理
http-response ^lhttps?:\/\/(?:[^\/]+\.)?(?:fqnovel|dragonread)\.com\/(?:novel|reading|api|service|v\d+)(?:\/|\?).*$ script-path=https://raw.githubusercontent.com/yy1589303118o/ChaJian/refs/heads/main/fanqie.js, requires-body=true, timeout=30, tag=番茄小说响应清理


[Mitm]
hostname = *.fqnovel.com, *.dragonread.com
